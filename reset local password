$Username = "support"
$NewPlainPassword = "YourVeryStrongRandomPasswordHere!123"
$SecurePassword = ConvertTo-SecureString $NewPlainPassword -AsPlainText -Force
$user = Get-LocalUser -Name $Username -ErrorAction SilentlyContinue
if ($user) {
   # User exists → reset password
   Set-LocalUser -Name $Username -Password $SecurePassword
   Write-Output "Password updated for $Username"
}
else {
   # User does NOT exist → create user
   New-LocalUser -Name $Username -Password $SecurePassword -FullName "Support Account" -Description "Local support account"
   # Add to Administrators group (optional but usually needed)
   Add-LocalGroupMember -Group "Administrators" -Member $Username
   Write-Output "User $Username created and added to Administrators"
}
