Get-LocalUser -Name "support"

$Username = "support"
$NewPlainPassword = "YourVeryStrongRandomPasswordHere!123"

$SecurePassword = ConvertTo-SecureString $NewPlainPassword -AsPlainText -Force

if (Get-LocalUser -Name $Username -ErrorAction SilentlyContinue) {
    Set-LocalUser -Name $Username -Password $SecurePassword
    Write-Output "Password successfully changed for $Username"
} else {
    Write-Output "User $Username not found"
}